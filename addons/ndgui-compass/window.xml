<?xml version="1.0" encoding="utf-8"?>
<root>
  <!-- Outlined band, 3 px/degree. Black outline is the border; the plate stays hidden while this shows. -->
  <View name="ndgui_compass_window" capture_input="true" composite_layer="true" view_layout="vertical">
    <View name="compass_pkg" view_layout="stacked" visible="true">
      <!-- One frame of the wrapped strip, exactly this wide, so the layout cannot scale it. -->
      <View name="pkg_clip" interactive="false" view_layout="stacked"
        min_size="Point(320,34)" max_size="Point(320,34)" h_alignment="left" v_alignment="top">
        <BitmapView name="pkg_band" interactive="false" image="library://notum.ndgui-lib/compass/frame/0000.png"
          min_size="Point(320,34)" max_size="Point(320,34)" h_alignment="left" v_alignment="top" />
      </View>
      <BitmapView name="pkg_waypoint" interactive="false" image="library://notum.ndgui-lib/compass/waypoint.png"
        visible="false" min_size="Point(23,29)" max_size="Point(23,29)" h_alignment="left" v_alignment="top" />
      <BitmapView name="pkg_caret" interactive="false" image="library://notum.ndgui-lib/compass/caret.png"
        min_size="Point(15,9)" max_size="Point(15,9)" h_alignment="left" v_alignment="top" />
    </View>
    <!-- Stock framed fallback -->
    <View name="compass_box" view_layout="stacked" visible="false">
      <BitmapView name="ndgui_compass_back" image="library://notum.ndgui-lib/chrome/plate.png" visible="false" />
      <PannedSurfaceView name="compass_band" capture_input="true" fill_color="transparent" />
      <BitmapView name="ndgui_compass_frame" image="gfx://GFX_GUI_COMPASS_FRAME" graphic_mode="tinted" color="3D6F9A" visible="false" />
    </View>
    <View name="compass_label" view_layout="stacked" h_alignment="center">
      <TextView name="compass_distance_shadow" value="" color="000000" font_size="11" text_alignment="center" size_to_text="false" layout_borders="Rect(1,1,0,0)" />
      <TextView name="compass_distance" value="" color="9CF0AE" font_size="11" text_alignment="center" size_to_text="false" />
    </View>
  </View>
</root>
