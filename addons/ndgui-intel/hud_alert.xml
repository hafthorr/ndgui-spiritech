<?xml version="1.0"?>
<root>
  <!-- a tell / your name / a watch word, for a few seconds. Click it to open the Log. -->
  <View name="alert" view_layout="stacked" capture_input="true" composite_layer="true" min_size="Point(420,30)" max_size="Point(420,30)">
    <BorderView name="alert_back" fill_color="0xC00A1016" />
    <BorderView name="alert_edge" fill_color="0xFF4FB3E8" min_size="Point(3,30)" max_size="Point(3,30)" h_alignment="left" />
    <View view_layout="horizontal" layout_borders="Rect(10,0,8,0)">
      <TextView name="alert_kind" value="" color="4FB3E8" font_size="11" size_to_text="false" min_size="Point(46,30)" max_size="Point(46,30)" v_alignment="center" />
      <TextView name="alert_text" value="" color="E6EEF5" font_size="13" size_to_text="false" weight="1" v_alignment="center" />
    </View>
    <Button name="alert_hit" flat="true" label="" selection_color="0x30789FBF" tooltip="Open the Log" />
  </View>
</root>
