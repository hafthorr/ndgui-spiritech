      <TextView name="alt_level" value="" color="C6A24E" font_size="12" size_to_text="false" text_alignment="right" min_size="Point(34,20)" max_size="Point(34,20)" v_alignment="center" layout_borders="Rect(0,0,8,0)" />
      <TextView name="alt_xp" value="" color="7F9BB0" font_size="11" size_to_text="false" min_size="Point(40,20)" max_size="Point(40,20)" v_alignment="center" />
      <TextView name="alt_cash" value="" color="9CD69C" font_size="12" size_to_text="false" text_alignment="right" min_size="Point(70,20)" max_size="Point(70,20)" v_alignment="center" layout_borders="Rect(0,0,10,0)" />
