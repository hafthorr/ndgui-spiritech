      <TextView name="alt_seen" value="" color="7F9BB0" font_size="11" size_to_text="false" min_size="Point(62,20)" max_size="Point(62,20)" v_alignment="center" />
      <TextView name="alt_locks" value="" color="E08A3C" font_size="11" size_to_text="false" interactive="true" min_size="Point(150,20)" max_size="Point(150,20)" v_alignment="center" />
