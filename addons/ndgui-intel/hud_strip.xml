    <BitmapView image="library://notum.ndgui-lib/chrome/strip.png" />
    <View view_layout="horizontal" layout_borders="Rect(2,2,4,2)">
      <View name="strip_grip" view_layout="stacked" capture_input="true" interactive="true" min_size="Point(12,22)" max_size="Point(12,22)" tooltip="Drag to move">
        <BitmapView image="library://notum.ndgui-lib/window/accent.png" min_size="Point(3,16)" max_size="Point(3,16)" h_alignment="center" v_alignment="center" />
      </View>
      <TextView name="strip_xp" value="XP --" color="C6A24E" font_size="12" size_to_text="false" interactive="true" min_size="Point(168,22)" max_size="Point(168,22)" v_alignment="center" layout_borders="Rect(4,0,0,0)" />
      <TextView name="strip_axp" value="" color="6CB6FF" font_size="12" size_to_text="false" interactive="true" min_size="Point(84,22)" max_size="Point(84,22)" v_alignment="center" />
      <TextView name="strip_cash" value="" color="9CD69C" font_size="12" size_to_text="false" interactive="true" min_size="Point(92,22)" max_size="Point(92,22)" v_alignment="center" />
      <TextView name="strip_time" value="" color="7F9BB0" font_size="12" size_to_text="false" interactive="true" min_size="Point(48,22)" max_size="Point(48,22)" v_alignment="center" />
      <View name="ndgui_btnwrap" view_layout="stacked" min_size="Point(44,22)" max_size="Point(44,22)" layout_borders="Rect(0,0,3,0)"><View name="ndgui_chrome" interactive="false" view_layout="horizontal"><BitmapView name="ndgui_btn_l" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_left.png" min_size="Point(4,22)" max_size="Point(4,22)" /><BitmapView name="ndgui_btn_m" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_middle.png" weight="1" min_size="Point(0,22)" max_size="Point(-1,22)" /><BitmapView name="ndgui_btn_r" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_right.png" min_size="Point(4,22)" max_size="Point(4,22)" /></View><Button name="strip_alts" label="Alts" font_size="11" min_size="Point(44,22)" max_size="Point(44,22)" tooltip="Your characters: level, credits, where, raid locks" flat="true" text_alignment="center" /></View>
      <View name="ndgui_btnwrap" view_layout="stacked" min_size="Point(52,22)" max_size="Point(52,22)" layout_borders="Rect(0,0,3,0)"><View name="ndgui_chrome" interactive="false" view_layout="horizontal"><BitmapView name="ndgui_btn_l" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_left.png" min_size="Point(4,22)" max_size="Point(4,22)" /><BitmapView name="ndgui_btn_m" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_middle.png" weight="1" min_size="Point(0,22)" max_size="Point(-1,22)" /><BitmapView name="ndgui_btn_r" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_right.png" min_size="Point(4,22)" max_size="Point(4,22)" /></View><Button name="strip_log" label="Log" font_size="11" min_size="Point(52,22)" max_size="Point(52,22)" tooltip="Tells, your name, watch words and loot this session" flat="true" text_alignment="center" /></View>
      <View name="ndgui_btnwrap" view_layout="stacked" min_size="Point(22,22)" max_size="Point(22,22)"><View name="ndgui_chrome" interactive="false" view_layout="horizontal"><BitmapView name="ndgui_btn_l" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_left.png" min_size="Point(4,22)" max_size="Point(4,22)" /><BitmapView name="ndgui_btn_m" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_middle.png" weight="1" min_size="Point(0,22)" max_size="Point(-1,22)" /><BitmapView name="ndgui_btn_r" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_right.png" min_size="Point(4,22)" max_size="Point(4,22)" /></View><Button name="strip_reset" label="0" font_size="11" min_size="Point(22,22)" max_size="Point(22,22)" tooltip="Start the session counters over" flat="true" text_alignment="center" /></View>
      <View weight="1" min_size="Point(0,22)" max_size="Point(-1,22)" />
      <View name="ndgui_btnwrap" view_layout="stacked" min_size="Point(22,22)" max_size="Point(22,22)"><View name="ndgui_chrome" interactive="false" view_layout="horizontal"><BitmapView name="ndgui_btn_l" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_left.png" min_size="Point(4,22)" max_size="Point(4,22)" /><BitmapView name="ndgui_btn_m" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_middle.png" weight="1" min_size="Point(0,22)" max_size="Point(-1,22)" /><BitmapView name="ndgui_btn_r" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_right.png" min_size="Point(4,22)" max_size="Point(4,22)" /></View><Button name="strip_close" label="x" font_size="11" min_size="Point(22,22)" max_size="Point(22,22)" tooltip="Hide the Intel strip, the Log and Alts. /ndgui hud shows the strip again." flat="true" text_alignment="center" /></View>
    </View>
  </View>
</root>
