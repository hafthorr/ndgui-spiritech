    <View name="meter_graph" view_layout="stacked" h_alignment="left" layout_borders="Rect(0,3,0,0)">
      <BitmapView name="meter_graph_back" image="library://notum.ndgui-lib/bars/track_h.png" />
      <View name="meter_columns" view_layout="horizontal" h_alignment="left" v_alignment="bottom" layout_borders="Rect(2,2,2,1)" />
