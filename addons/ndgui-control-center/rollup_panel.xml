<?xml version="1.0"?>
<root>
  <!-- ndGUI: the right-side docking column (Options > Interface & HUD > Show rollup panel).
       Windows dragged onto it by their title bar dock here; the native rollup host moves them into rollup_pages. -->
  <View name="rollup_panel" capture_input="true" color="Default" view_layout="stacked" visible="false">
    <View name="rollup_background" view_layout="stacked" capture_input="false">
      <BitmapView name="ndgui_column_glass" image="library://notum.ndgui-lib/window/glass.png" />
      <BitmapView name="ndgui_column_edge" image="library://notum.ndgui-lib/window/edge_v.png" min_size="Point(3,1)" max_size="Point(3,-1)" h_alignment="left" />
    </View>
    <ScrollView name="rollup_scroll" capture_input="true" interactive="true" view_layout="vertical"
                v_scrollbar_mode="auto" scrollbar_width="11" scrollbar_right_inset="1" layout_borders="Rect(3,0,0,0)">
      <ScrollViewChild name="rollup_pages" view_layout="vertical" />
    </ScrollView>
  </View>
</root>
