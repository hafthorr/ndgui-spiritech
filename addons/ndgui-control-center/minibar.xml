<?xml version="1.0"?>
<!-- ndGUI minibar: package icons + flat DarkTech fills (no GFX_GUI_SB_* atlas). -->
<root>
  <View name="minibar" view_layout="horizontal" h_alignment="right" v_alignment="top"
        visible="false">
    <Button name="minibar_wear" flat="true" fill_color="0xFF16202A" active_fill_color="0xFF3D6F9A" min_size="Point(19,20)" max_size="Point(19,20)" tooltip="Wear" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/icons/wear.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
    <Button name="minibar_actions" flat="true" fill_color="0xFF16202A" active_fill_color="0xFF3D6F9A" min_size="Point(19,20)" max_size="Point(19,20)" tooltip="Controls / Actions" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/icons/actions.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
    <Button name="minibar_knowledge" flat="true" fill_color="0xFF16202A" min_size="Point(19,20)" max_size="Point(19,20)"
            enabled="false" tooltip="Knowledge — not yet available" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/window/info.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
    <Button name="minibar_missions" flat="true" fill_color="0xFF16202A" active_fill_color="0xFF3D6F9A" min_size="Point(19,20)" max_size="Point(19,20)" tooltip="Missions" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/icons/missions.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
    <Button name="minibar_team" flat="true" fill_color="0xFF16202A" active_fill_color="0xFF3D6F9A" min_size="Point(19,20)" max_size="Point(19,20)" tooltip="Team" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/icons/team.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
    <Button name="minibar_playfield_map" flat="true" fill_color="0xFF16202A" active_fill_color="0xFF3D6F9A" min_size="Point(19,20)" max_size="Point(19,20)" tooltip="PF Map" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/icons/map.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
    <Button name="minibar_friends" flat="true" fill_color="0xFF16202A" active_fill_color="0xFF3D6F9A" min_size="Point(19,20)" max_size="Point(19,20)" tooltip="Friends" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/icons/friends.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
    <Button name="minibar_programs" flat="true" fill_color="0xFF16202A" active_fill_color="0xFF3D6F9A" min_size="Point(19,20)" max_size="Point(19,20)" tooltip="Programs" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/icons/nano.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
    <Button name="minibar_stats" flat="true" fill_color="0xFF16202A" active_fill_color="0xFF3D6F9A" min_size="Point(19,20)" max_size="Point(19,20)" tooltip="Stats" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/icons/character.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
    <Button name="minibar_ncu" flat="true" fill_color="0xFF16202A" active_fill_color="0xFF3D6F9A" min_size="Point(19,20)" max_size="Point(19,20)" tooltip="NCU" view_layout="stacked">
      <BitmapView interactive="false" image="library://notum.ndgui-lib/icons/ncu.png" min_size="Point(16,16)" max_size="Point(16,16)" h_alignment="center" v_alignment="center" />
    </Button>
  </View>
</root>
