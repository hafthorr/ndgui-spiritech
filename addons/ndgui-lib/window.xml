<?xml version="1.0" standalone="yes"?>
<root>
  <View name="window" capture_input="true" color="Default" composite_layer="true" interaction_scope="true" view_layout="stacked">
    <View name="window_outer" view_layout="stacked" capture_input="false">
      <BitmapView name="ndgui_glass" image="library://notum.ndgui-lib/window/glass.png" />
      <BitmapView name="ndgui_titlebar_back" image="library://notum.ndgui-lib/window/titlebar.png" min_size="Point(1,27)" max_size="Point(-1,27)" v_alignment="top" />
      <BitmapView name="ndgui_edge_top" image="library://notum.ndgui-lib/window/edge_top.png" min_size="Point(1,3)" max_size="Point(-1,3)" v_alignment="top" />
      <BitmapView name="ndgui_edge_bottom" image="library://notum.ndgui-lib/window/edge_h.png" min_size="Point(1,3)" max_size="Point(-1,3)" v_alignment="bottom" />
      <BitmapView name="ndgui_edge_left" image="library://notum.ndgui-lib/window/edge_v.png" min_size="Point(3,1)" max_size="Point(3,-1)" h_alignment="left" />
      <BitmapView name="ndgui_edge_right" image="library://notum.ndgui-lib/window/edge_v_r.png" min_size="Point(3,1)" max_size="Point(3,-1)" h_alignment="right" />
      <BitmapView name="ndgui_corner_tl" image="library://notum.ndgui-lib/window/corner_tl.png" min_size="Point(7,7)" max_size="Point(7,7)" h_alignment="left" v_alignment="top" layout_borders="Rect(3,3,0,0)" />
      <BitmapView name="ndgui_corner_tr" image="library://notum.ndgui-lib/window/corner_tr.png" min_size="Point(7,7)" max_size="Point(7,7)" h_alignment="right" v_alignment="top" layout_borders="Rect(0,3,3,0)" />
      <BitmapView name="ndgui_corner_bl" image="library://notum.ndgui-lib/window/corner_bl.png" min_size="Point(7,7)" max_size="Point(7,7)" h_alignment="left" v_alignment="bottom" layout_borders="Rect(3,0,0,3)" />
      <BitmapView name="ndgui_corner_br" image="library://notum.ndgui-lib/window/corner_br.png" min_size="Point(7,7)" max_size="Point(7,7)" h_alignment="right" v_alignment="bottom" layout_borders="Rect(0,0,3,3)" />
    </View>
    <View name="window_inner" view_layout="stacked" capture_input="false" layout_borders="Rect(4,27,4,4)">
      <BitmapView name="ndgui_inner" image="library://notum.ndgui-lib/window/inner.png" />
    </View>
    <View view_layout="vertical" weight="1" layout_borders="Rect(3,3,3,3)">
      <!-- titlebar furniture must add up like Core's: Window:fit_title caps the title at width - TITLEBAR_FURNITURE -->
      <View name="window_titlebar" view_layout="horizontal" capture_input="true" min_size="Point(-1,24)" max_size="Point(-1,24)">
        <BitmapView name="window_icon" interactive="true" image="gfx://GFX_GUI_WINDOW_ICON_I" min_size="Point(15,15)" max_size="Point(15,15)" v_alignment="center" layout_borders="Rect(3,0,0,1)" />
        <BitmapView name="ndgui_accent" image="library://notum.ndgui-lib/window/accent.png" min_size="Point(3,18)" max_size="Point(3,18)" v_alignment="center" layout_borders="Rect(4,0,0,0)" />
        <View name="window_title_tab" view_layout="stacked" min_size="Point(-1,18)" max_size="Point(-1,18)" v_alignment="center" layout_borders="Rect(0,0,0,0)">
          <BitmapView name="ndgui_tab" image="library://notum.ndgui-lib/window/tab.png" />
          <View view_layout="horizontal">
            <TextView name="window_title" weight="1" color="C5D7E6" font_size="13" layout_borders="Rect(6,0,0,0)" v_alignment="center" />
            <HLayoutSpacer weight="0" min_size="Point(14,0)" max_size="Point(14,0)" />
          </View>
        </View>
        <View name="window_tabs" view_layout="horizontal" selected_on_top="true" v_alignment="top" min_size="Point(-1,17)" max_size="Point(-1,17)" layout_borders="Rect(3,7,0,0)" />
        <HLayoutSpacer />
        <Button name="window_pin" visible="false" alpha="0.6" active_alpha="1" min_size="Point(15,15)" max_size="Point(15,15)" v_alignment="center" layout_borders="Rect(0,0,3,1)" gfxid_raised="GFX_GUI_WINDOW_PIN" gfxid_hover="GFX_GUI_WINDOW_PIN_STATE2" gfxid_pressed="GFX_GUI_WINDOW_PIN_STATE3" gfxid_selected="GFX_NDGUI_PIN_ON" />
        <Button name="window_close" visible="false" alpha="0.9" active_alpha="1" min_size="Point(15,15)" max_size="Point(15,15)" v_alignment="center" layout_borders="Rect(0,0,4,1)" gfxid_raised="GFX_GUI_WINDOW_CLOSE_X" gfxid_hover="GFX_GUI_WINDOW_CLOSE_X_STATE2" gfxid_pressed="GFX_GUI_WINDOW_CLOSE_X_STATE3" />
      </View>
      <!-- content borders must match Core (2,1,2,2): the game sizes grid windows with Window.CONTENT_SIDES/ENDS -->
      <View name="window_content" view_layout="vertical" weight="1" layout_borders="Rect(2,1,2,2)" />
    </View>
  </View>
</root>
