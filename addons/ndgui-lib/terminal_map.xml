<?xml version="1.0" standalone="yes"?>
<root>
  <!-- ndGUI Mission Terminal offer map (client 0.3.5+): the planet map with a numbered marker per offer.
       Sits to the right of the offer column; terminal_map.lua draws it. -->
  <View name="terminal_map" view_layout="vertical" weight="1" layout_borders="Rect(0,4,5,5)">
    <View name="terminal_map_frame" view_layout="stacked" weight="1">
      <View name="terminal_map_back" />
      <PannedSurfaceView name="terminal_map_tiles" capture_input="true" pointer_pan="true" weight="1" layout_borders="Rect(1,1,1,1)" />
    </View>
    <View view_layout="horizontal" min_size="Point(-1,26)" max_size="Point(-1,26)" layout_borders="Rect(0,4,0,0)">
      <TextView name="terminal_map_hint" value="Drag to pan, wheel to zoom, click a number to pick it" font_size="10" color="7F9BB0" size_to_text="false" weight="1" min_size="Point(40,22)" max_size="Point(-1,22)" v_alignment="center" />
      <View name="ndgui_btnwrap" view_layout="stacked" min_size="Point(22,22)" max_size="Point(22,22)"><View name="ndgui_chrome" interactive="false" view_layout="horizontal"><BitmapView name="ndgui_btn_l" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_left.png" min_size="Point(4,22)" max_size="Point(4,22)" /><BitmapView name="ndgui_btn_m" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_middle.png" weight="1" min_size="Point(0,22)" max_size="Point(-1,22)" /><BitmapView name="ndgui_btn_r" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_right.png" min_size="Point(4,22)" max_size="Point(4,22)" /></View><Button name="terminal_map_zoom_out" label="-" font_size="13" min_size="Point(22,22)" max_size="Point(22,22)" tooltip="Zoom out" flat="true" text_alignment="center" /></View>
      <View name="ndgui_btnwrap" view_layout="stacked" min_size="Point(22,22)" max_size="Point(22,22)"><View name="ndgui_chrome" interactive="false" view_layout="horizontal"><BitmapView name="ndgui_btn_l" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_left.png" min_size="Point(4,22)" max_size="Point(4,22)" /><BitmapView name="ndgui_btn_m" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_middle.png" weight="1" min_size="Point(0,22)" max_size="Point(-1,22)" /><BitmapView name="ndgui_btn_r" interactive="false" image="library://notum.ndgui-lib/buttons/btn22_raised_right.png" min_size="Point(4,22)" max_size="Point(4,22)" /></View><Button name="terminal_map_zoom_in" label="+" font_size="13" min_size="Point(22,22)" max_size="Point(22,22)" tooltip="Zoom in" flat="true" text_alignment="center" /></View>
    </View>
  </View>
</root>
