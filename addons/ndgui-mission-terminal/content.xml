<?xml version="1.0" standalone="yes"?>
<root>
  <!-- ndGUI Mission Terminal: offers as readable rows, a watch list that flags offers you want,
       slider presets, the chosen-reward panel with roll cost, and this session's roll log.
       Sizes are set from main.lua. -->
  <View name="mission_terminal" view_layout="vertical" layout_borders="Rect(5,4,5,5)">
    <TextView name="status" value="" font_size="11" color="9FB3C4" size_to_text="false" min_size="Point(-1,15)" max_size="Point(-1,15)" />
    <View name="offers" view_layout="vertical" layout_borders="Rect(0,3,0,0)" />
    <!-- watch list -->
    <TextView name="watch_head" value="WATCH FOR  (comma separated: item, zone, type...)" font_size="11" color="7F9BB0" size_to_text="false" min_size="Point(-1,15)" max_size="Point(-1,15)" layout_borders="Rect(0,8,0,2)" />
    <View view_layout="horizontal" min_size="Point(-1,22)" max_size="Point(-1,22)">
      <TextInputView name="watch" font_size="11" max_length="200" weight="1" min_size="Point(60,22)" max_size="Point(-1,22)" v_alignment="center" tooltip="Offers whose summary mentions any of these light up gold" />
      <Button name="watch_clear" label="Clear" font_size="11" min_size="Point(46,22)" max_size="Point(46,22)" layout_borders="Rect(4,0,0,0)" tooltip="Clear the watch list" gfxid_raised_left="GFX_NDGUI_BTN22_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN22_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN22_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN22_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN22_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN22_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN22_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN22_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN22_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN22_SELECTED" />
    </View>
    <!-- reward mode -->
    <View view_layout="horizontal" min_size="Point(-1,22)" max_size="Point(-1,22)" layout_borders="Rect(0,8,0,0)">
      <Button name="mode_random" label="Random reward" font_size="11" weight="1" min_size="Point(40,22)" max_size="Point(-1,22)" layout_borders="Rect(0,0,0,0)" tooltip="Missions reward a random item" gfxid_raised_left="GFX_NDGUI_BTN22_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN22_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN22_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN22_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN22_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN22_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN22_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN22_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN22_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN22_SELECTED" />
      <Button name="mode_pinned" label="Chosen reward" font_size="11" weight="1" min_size="Point(40,22)" max_size="Point(-1,22)" layout_borders="Rect(4,0,0,0)" tooltip="Missions become a chain that ends with a reward you choose" gfxid_raised_left="GFX_NDGUI_BTN22_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN22_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN22_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN22_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN22_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN22_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN22_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN22_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN22_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN22_SELECTED" />
    </View>
    <View name="reward_row" view_layout="stacked" visible="false" layout_borders="Rect(0,6,0,0)">
      <View name="reward_back" />
      <View view_layout="horizontal" layout_borders="Rect(4,4,4,4)">
        <ItemSlotView name="reward_slot" min_size="Point(40,40)" max_size="Point(40,40)" icon_fit="center" icon_inset="3" tooltip="Choose the reward" />
        <View view_layout="vertical" weight="1" layout_borders="Rect(6,0,4,0)">
          <TextView name="reward_name" font_size="12" color="F2F25C" size_to_text="false" min_size="Point(-1,16)" max_size="Point(-1,16)" />
          <TextView name="reward_ql" font_size="11" color="C5D7E6" size_to_text="false" min_size="Point(-1,14)" max_size="Point(-1,14)" />
          <TextView name="reward_cost" font_size="11" color="FFD24A" size_to_text="false" min_size="Point(-1,14)" max_size="Point(-1,14)" />
        </View>
        <Button name="reward_clear" label="Clear" font_size="11" min_size="Point(46,20)" max_size="Point(46,20)" layout_borders="Rect(0,0,0,0)" tooltip="Clear the chosen reward" gfxid_raised_left="GFX_NDGUI_BTN20_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN20_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN20_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN20_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN20_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN20_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN20_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN20_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN20_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN20_SELECTED" v_alignment="center" />
      </View>
    </View>
    <TextView name="recent" value="" font_size="10" color="7F9BB0" size_to_text="false" word_wrap="true" visible="false" layout_borders="Rect(0,3,0,0)" />
    <!-- sliders + presets -->
    <TextView name="prefs_head" value="MISSION PREFERENCES" font_size="11" color="7F9BB0" size_to_text="false" min_size="Point(-1,15)" max_size="Point(-1,15)" layout_borders="Rect(0,8,0,2)" />
    <View view_layout="horizontal" min_size="Point(-1,20)" max_size="Point(-1,20)" layout_borders="Rect(0,0,0,4)">
      <Button name="preset_1" label="Preset 1" font_size="11" weight="1" min_size="Point(40,20)" max_size="Point(-1,20)" layout_borders="Rect(0,0,0,0)" tooltip="" gfxid_raised_left="GFX_NDGUI_BTN20_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN20_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN20_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN20_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN20_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN20_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN20_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN20_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN20_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN20_SELECTED" />
      <Button name="preset_2" label="Preset 2" font_size="11" weight="1" min_size="Point(40,20)" max_size="Point(-1,20)" layout_borders="Rect(3,0,0,0)" tooltip="" gfxid_raised_left="GFX_NDGUI_BTN20_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN20_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN20_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN20_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN20_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN20_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN20_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN20_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN20_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN20_SELECTED" />
      <Button name="preset_3" label="Preset 3" font_size="11" weight="1" min_size="Point(40,20)" max_size="Point(-1,20)" layout_borders="Rect(3,0,0,0)" tooltip="" gfxid_raised_left="GFX_NDGUI_BTN20_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN20_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN20_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN20_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN20_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN20_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN20_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN20_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN20_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN20_SELECTED" />
      <Button name="preset_4" label="Preset 4" font_size="11" weight="1" min_size="Point(40,20)" max_size="Point(-1,20)" layout_borders="Rect(3,0,0,0)" tooltip="" gfxid_raised_left="GFX_NDGUI_BTN20_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN20_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN20_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN20_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN20_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN20_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN20_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN20_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN20_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN20_SELECTED" />
    </View>
    <View name="slider_rows" view_layout="vertical" h_alignment="center">
      <View name="row_difficulty" view_layout="horizontal">
        <TextView name="row_difficulty_min" font_size="11" color="C5D7E6" text_alignment="right" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
        <Slider name="slider_difficulty" min_size="Point(110,13)" max_size="Point(110,13)" v_alignment="center" layout_borders="Rect(5,0,5,0)" bg_gfx="GFX_GUI_MISSION_SLIDER_BACKGROUND" thumb_gfx="GFX_GUI_CONTROLCENTER_AGGDEF_SLIDER" thumb_width="11" color="FFFFFF" />
        <TextView name="row_difficulty_max" font_size="11" color="C5D7E6" text_alignment="left" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
      </View>
      <View name="row_good" view_layout="horizontal">
        <TextView name="row_good_min" font_size="11" color="C5D7E6" text_alignment="right" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
        <Slider name="slider_good" min_size="Point(110,13)" max_size="Point(110,13)" v_alignment="center" layout_borders="Rect(5,0,5,0)" bg_gfx="GFX_GUI_MISSION_SLIDER_BACKGROUND" thumb_gfx="GFX_GUI_CONTROLCENTER_AGGDEF_SLIDER" thumb_width="11" color="FFFFFF" />
        <TextView name="row_good_max" font_size="11" color="C5D7E6" text_alignment="left" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
      </View>
      <View name="row_order" view_layout="horizontal">
        <TextView name="row_order_min" font_size="11" color="C5D7E6" text_alignment="right" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
        <Slider name="slider_order" min_size="Point(110,13)" max_size="Point(110,13)" v_alignment="center" layout_borders="Rect(5,0,5,0)" bg_gfx="GFX_GUI_MISSION_SLIDER_BACKGROUND" thumb_gfx="GFX_GUI_CONTROLCENTER_AGGDEF_SLIDER" thumb_width="11" color="FFFFFF" />
        <TextView name="row_order_max" font_size="11" color="C5D7E6" text_alignment="left" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
      </View>
      <View name="row_open" view_layout="horizontal">
        <TextView name="row_open_min" font_size="11" color="C5D7E6" text_alignment="right" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
        <Slider name="slider_open" min_size="Point(110,13)" max_size="Point(110,13)" v_alignment="center" layout_borders="Rect(5,0,5,0)" bg_gfx="GFX_GUI_MISSION_SLIDER_BACKGROUND" thumb_gfx="GFX_GUI_CONTROLCENTER_AGGDEF_SLIDER" thumb_width="11" color="FFFFFF" />
        <TextView name="row_open_max" font_size="11" color="C5D7E6" text_alignment="left" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
      </View>
      <View name="row_physical" view_layout="horizontal">
        <TextView name="row_physical_min" font_size="11" color="C5D7E6" text_alignment="right" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
        <Slider name="slider_physical" min_size="Point(110,13)" max_size="Point(110,13)" v_alignment="center" layout_borders="Rect(5,0,5,0)" bg_gfx="GFX_GUI_MISSION_SLIDER_BACKGROUND" thumb_gfx="GFX_GUI_CONTROLCENTER_AGGDEF_SLIDER" thumb_width="11" color="FFFFFF" />
        <TextView name="row_physical_max" font_size="11" color="C5D7E6" text_alignment="left" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
      </View>
      <View name="row_headon" view_layout="horizontal">
        <TextView name="row_headon_min" font_size="11" color="C5D7E6" text_alignment="right" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
        <Slider name="slider_headon" min_size="Point(110,13)" max_size="Point(110,13)" v_alignment="center" layout_borders="Rect(5,0,5,0)" bg_gfx="GFX_GUI_MISSION_SLIDER_BACKGROUND" thumb_gfx="GFX_GUI_CONTROLCENTER_AGGDEF_SLIDER" thumb_width="11" color="FFFFFF" />
        <TextView name="row_headon_max" font_size="11" color="C5D7E6" text_alignment="left" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
      </View>
      <View name="row_credits" view_layout="horizontal">
        <TextView name="row_credits_min" font_size="11" color="C5D7E6" text_alignment="right" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
        <Slider name="slider_credits" min_size="Point(110,13)" max_size="Point(110,13)" v_alignment="center" layout_borders="Rect(5,0,5,0)" bg_gfx="GFX_GUI_MISSION_SLIDER_BACKGROUND" thumb_gfx="GFX_GUI_CONTROLCENTER_AGGDEF_SLIDER" thumb_width="11" color="FFFFFF" />
        <TextView name="row_credits_max" font_size="11" color="C5D7E6" text_alignment="left" min_size="Point(0,17)" max_size="Point(0,-1)" v_alignment="center" />
      </View>
    </View>
    <!-- roll log: offers that matched, kept after you re-roll -->
    <TextView name="log_head" value="MATCHES THIS SESSION" font_size="11" color="7F9BB0" size_to_text="false" min_size="Point(-1,15)" max_size="Point(-1,15)" layout_borders="Rect(0,8,0,2)" />
    <TextView name="log" value="" font_size="10" color="C5D7E6" size_to_text="false" word_wrap="true" />
    <View view_layout="horizontal" layout_borders="Rect(0,8,0,0)">
      <Button name="request" label="Request" font_size="11" weight="1" min_size="Point(40,28)" max_size="Point(-1,28)" layout_borders="Rect(0,0,0,0)" tooltip="Roll new offers" gfxid_raised_left="GFX_NDGUI_BTN28_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN28_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN28_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN28_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN28_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN28_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN28_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN28_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN28_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN28_SELECTED" />
      <Button name="accept" label="Accept" font_size="11" min_size="Point(96,28)" max_size="Point(96,28)" layout_borders="Rect(4,0,0,0)" tooltip="" gfxid_raised_left="GFX_NDGUI_BTN28_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN28_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN28_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN28_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN28_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN28_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN28_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN28_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN28_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN28_SELECTED" />
      <Button name="cancel" label="Cancel" font_size="11" min_size="Point(64,28)" max_size="Point(64,28)" layout_borders="Rect(4,0,0,0)" tooltip="" gfxid_raised_left="GFX_NDGUI_BTN28_RAISED_LEFT" gfxid_raised_middle="GFX_NDGUI_BTN28_RAISED_MIDDLE" gfxid_raised_right="GFX_NDGUI_BTN28_RAISED_RIGHT" gfxid_hover_left="GFX_NDGUI_BTN28_HOVER_LEFT" gfxid_hover_middle="GFX_NDGUI_BTN28_HOVER_MIDDLE" gfxid_hover_right="GFX_NDGUI_BTN28_HOVER_RIGHT" gfxid_pressed_left="GFX_NDGUI_BTN28_PRESSED_LEFT" gfxid_pressed_middle="GFX_NDGUI_BTN28_PRESSED_MIDDLE" gfxid_pressed_right="GFX_NDGUI_BTN28_PRESSED_RIGHT" gfxid_selected="GFX_NDGUI_BTN28_SELECTED" />
    </View>
  </View>
</root>
